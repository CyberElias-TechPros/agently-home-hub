# ── Agently API environment ────────────────────────────────────────────────
# Copy to `.env` for local development. Never commit real secrets.

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Trust & discovery
#   "*"          → allow any origin (local dev only)
#   comma-list   → e.g. "http://localhost:5173,http://localhost:8080"
ALLOWED_ORIGINS=*

# Auth (change these in production!)
#   Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-please
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
# Access token lifetime (Cloudflare-compatible JS, e.g. "1h", "15m", "30m")
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL_DAYS=7

# Database
DATABASE_PATH=./data/agently.db

# Payments — Paystack (Nigeria, NGN)
#   Test keys available from https://dashboard.paystack.com (Test mode).
#   Leave empty to run in "simulation" mode: intents resolve instantly,
#   marked `test_mode: true`, so every happy path works without keys.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_ENABLED=false
# Default ₦ fee applied to bookings (0 = free)
BOOKING_FEE_NGN=0

# Email (transactional: verification, password reset, notifications)
#   Leave SMTP_HOST empty to use the console/development mailbox:
#   emails are logged and the latest one is retrievable at GET /api/dev/mailbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Agently <no-reply@agently.app>"
# Public origin used to build email links (verification / password reset)
FRONTEND_URL=http://localhost:5173
