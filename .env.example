# Frontend environment
#
# Only values that are SAFE TO SHIP TO A BROWSER belong here. Anything with the
# VITE_ prefix is inlined into the JavaScript bundle and is therefore public —
# never put a secret, API key or token here. Server-side secrets live in the
# Worker (see worker/.dev.vars.example).

# Where the API is served from. Leave unset in production: the app then calls
# the same origin under /api, which Vercel rewrites to the Worker.
# VITE_API_URL=http://localhost:8787

# Canonical origin, used for canonical URLs, sitemap entries and Open Graph tags.
# VITE_SITE_URL=https://agently.app
