# API Configuration
VITE_API_URL=http://localhost:3002/api

# Authentication
VITE_JWT_SECRET=your-jwt-secret-here

# External Services
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-key
VITE_OPENAI_API_KEY=your-openai-api-key

# Email Service
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# File Upload
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name
DOCUMENT_STORAGE_TYPE=local  # 'local' or 's3'
DOCUMENT_STORAGE_PATH=./uploads/documents

# DocuSign Configuration
DOCUSIGN_CLIENT_ID=your-docusign-client-id
DOCUSIGN_USER_ID=your-docusign-user-id
DOCUSIGN_ACCOUNT_ID=your-docusign-account-id
DOCUSIGN_PRIVATE_KEY_PATH=path/to/docusign/private.key
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi

# Analytics
VITE_GOOGLE_ANALYTICS_ID=your-ga-id
VITE_MIXPANEL_TOKEN=your-mixpanel-token

# Environment
NODE_ENV=development